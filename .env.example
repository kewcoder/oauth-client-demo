# HitPay server URLs — the only values required in .env
HITPAY_OAUTH_AUTHORIZE_URL=https://dashboard.hit-pay.com/oauth/authorize
HITPAY_API_BASE_URL=https://api.hit-pay.com

# Optional: set these as env-var fallbacks instead of using the browser form.
# If set, they pre-fill the form on the home page.
# HITPAY_CLIENT_ID=
# HITPAY_CLIENT_SECRET=
# HITPAY_REDIRECT_URI=https://localhost:3000/api/oauth/callback
# HITPAY_SCOPES=business:read payments payments:read payments:create payments:cancel payments:refund
